{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "failures_summary": {
      "properties": {
        "count": {
          "type": "integer"
        },
        "modes": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        }
      },
      "required": [
        "count",
        "modes"
      ],
      "type": "object"
    },
    "generated_at_iso8601": {
      "format": "date-time",
      "type": "string"
    },
    "input_run_path": {
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "type": [
          "number",
          "integer",
          "null"
        ]
      },
      "type": "object"
    },
    "missing_data": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "venue_id": {
      "type": "string"
    }
  },
  "required": [
    "venue_id",
    "input_run_path",
    "generated_at_iso8601",
    "metrics",
    "missing_data",
    "failures_summary"
  ],
  "title": "TOSEM HAIL post-submission revision analysis output schema",
  "type": "object"
}
